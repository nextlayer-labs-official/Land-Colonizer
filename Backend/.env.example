# HTTP port the Express server listens on
PORT=4000

# JWT signing secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# JWT token lifetime
JWT_EXPIRES_IN=7d

# Prisma / MySQL connection string
DATABASE_URL="mysql://user:password@localhost:3306/ams"

# Comma-separated allowed CORS origins (set to your frontend URL in production)
# Leave blank to allow all origins (development only)
CORS_ORIGIN=http://localhost:3000

# Environment (development | production)
NODE_ENV=development

# ── Outgoing email (password reset codes, notifications) ─────────────────────
# Zoho ZeptoMail (Zoho CPaaS) SMTP: host smtp.zeptomail.com, port 587 (TLS) or 465 (SSL),
# username "emailapikey", password = the SMTP password shown in the ZeptoMail dashboard.
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_USER=emailapikey
SMTP_PASS=
# Must be an address on a domain verified in ZeptoMail
MAIL_FROM_EMAIL=noreply@yourdomain.com
# Optional — defaults to the company name in Settings
MAIL_FROM_NAME=
# Optional — "true" for SSL (port 465). Leave blank to pick automatically from the port.
SMTP_SECURE=
